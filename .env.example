# env: production, development
ENVIRONMENT=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disks_ps
DB_USER=postgres
DB_PASSWORD=postgres

# Telegram Bot
BOT_TOKEN=
OWNER_ID=
PROXY_URL=socks5://127.0.0.1:3067

# Finance Configuration
INITIAL_BALANCE=0
REVENUE=0
DISCS_COUNT_SOLD=0 
ALL_ASSETS=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# API
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
API_DOCS_ENABLED=true

API_MAX_REQUEST_BODY_BYTES=0
API_RATE_LIMIT_ENABLED=false

API_TOKEN=
# API_TOKEN_SHA256=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_LIMIT=100
RATE_LIMIT_TOKEN_LIMIT=1000
RATE_LIMIT_WINDOW_SIZE=60
RATE_LIMIT_REDIS_FAILURE_POLICY=fail-closed




